rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // グローバルランキング - 誰でも読み取り可能・本人のドキュメントのみ書き込み可
    match /rankings/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 都道府県別ランキング - 誰でも読み取り可能・本人のエントリのみ書き込み可
    match /prefecture_rankings/{prefDifficulty}/entries/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId;
    }

    // ユーザープロフィール - 本人のみ
    match /user_profiles/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
    }

    // デイリーボーナス - 本人のみ（Cloud Functions から書き込み）
    match /daily_bonuses/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if false;
    }
  }
}
