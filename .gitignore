# モノレポルート用。各アプリ固有の無視ルールは apps/<app>/.gitignore を参照。
.dart_tool/
.idea/
*.iml
*.log
build/
.flutter-plugins
.flutter-plugins-dependencies
.github/workflows/

# Environment variables
.env
.env.local
.env.*.local
.env.production.local
.env.development.local

# Firebase & API keys
google-services.json
GoogleService-Info.plist
firebase*.json

# SSH/SSL Keys
*.pem
*.p8
*.key
*.p12
*.keystore

# Credentials
credentials.json
*-creds.json

# Secrets
*secret*
*token*

# App Store & Play Store
*.jks
*.keystore
appstore_api_key.p8
